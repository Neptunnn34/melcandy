{
  "name": "MelCandy",
  "short_name": "MelCandy",
  "description": "Melisa ve Can için özel, mobil öncelikli sosyal alan.",
  "lang": "tr",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#1e1e22",
